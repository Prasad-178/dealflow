# Database (local Docker Postgres with pgvector)
# Start with: docker compose up -d
DATABASE_URL=postgresql://dealflow:dealflow@localhost:5433/dealflow

# OpenAI
OPENAI_API_KEY=sk-...

# Inngest
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Auth (NextAuth.js)
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Integrations (all optional — graceful fallbacks without them) ---

# Email (Resend) — https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Slack — https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Slack MCP (optional — for agent workspace search capabilities)
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# Telegram — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_SECRET=...

# Google Calendar — https://console.cloud.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=...@...iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
GOOGLE_CALENDAR_ID=primary

# Default company for webhook messages
DEFAULT_COMPANY_ID=

# Frontend integration status flags (set to "true" when configured)
NEXT_PUBLIC_RESEND_CONFIGURED=false
NEXT_PUBLIC_SLACK_CONFIGURED=false
NEXT_PUBLIC_TELEGRAM_CONFIGURED=false
NEXT_PUBLIC_CALENDAR_CONFIGURED=false
